###> doctrine/doctrine-bundle ###
# PostgreSQL — base dédiée au microservice User (table "user")
# Doit correspondre à compose.yaml (service database : nephro_users, postgres/root par défaut).
# Prérequis PHP : extension pdo_pgsql activée (php.ini).
# Démarrer Postgres : docker compose up -d database   (depuis ce dossier user-service)
#
# Format : postgresql://USER:PASSWORD@HOST:PORT/DB?serverVersion=16&charset=utf8
# Si erreur "authentification par mot de passe échouée" : le mot de passe ne correspond pas.
# - Postgres installé sur Windows : mets le mot de passe que tu as défini à l'installation.
# - Docker (compose.yaml) : postgres / root sur 5432 — arrête l'autre Postgres sur 5432 si conflit.
# Surcharge locale (recommandé) : crée .env.local avec une ligne DATABASE_URL="..." (non versionné).
DATABASE_URL="postgresql://postgres:root@127.0.0.1:5432/nephro_users?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

# -----------------------------
# Keycloak (Bearer token validation)
# -----------------------------
# Préférez 127.0.0.1 sous Windows : « localhost » peut viser IPv6 (::1) alors que Keycloak n’écoute que sur IPv4.
KEYCLOAK_BASE_URL=http://127.0.0.1:8080
KEYCLOAK_REALM=kidneyCare-realm
KEYCLOAK_CLIENT_ID=kidneycare-app
KEYCLOAK_CLIENT_SECRET=
# HTTPS Keycloak avec certificat auto-signé : KEYCLOAK_HTTP_INSECURE=1 (désactive verify SSL côté PHP)
# KEYCLOAK_HTTP_INSECURE=0
# Compte admin realm master (inscription patient → API admin Keycloak). À adapter ou surcharger dans .env.local
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Gateway Spring (sync profil patient MySQL après inscription)
NEPHRO_GATEWAY_BASE_URL=http://127.0.0.1:8095